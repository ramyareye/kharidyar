{
	"name": "kharidyar",
	"version": "0.0.0",
	"description": "Private collaborative purchase planning workspace",
	"private": true,
	"packageManager": "bun@1.3.12",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter @kharidyar/web build",
		"build:preview": "bun run --filter @kharidyar/web build:preview",
		"cf-typegen": "bun run --filter @kharidyar/web cf-typegen",
		"check": "bun run lint && bun run typecheck && bun run db:check && bun run test && bun run --filter @kharidyar/web check:deploy:production",
		"db:check": "bun run --filter @kharidyar/web db:check",
		"db:generate": "bun run --filter @kharidyar/web db:generate",
		"db:bookmark:preview": "bun run --filter @kharidyar/web db:bookmark:preview",
		"db:bookmark:production": "bun run --filter @kharidyar/web db:bookmark:production",
		"db:migrate:local": "bun run --filter @kharidyar/web db:migrate:local",
		"db:migrate:preview": "bun run --filter @kharidyar/web db:migrate:preview",
		"db:migrate:production": "bun run --filter @kharidyar/web db:migrate:production",
		"db:migrations:list:local": "bun run --filter @kharidyar/web db:migrations:list:local",
		"db:migrations:list:preview": "bun run --filter @kharidyar/web db:migrations:list:preview",
		"db:migrations:list:production": "bun run --filter @kharidyar/web db:migrations:list:production",
		"db:seed:local": "bun run --filter @kharidyar/web db:seed:local",
		"deploy": "bun run deploy:production",
		"deploy:preview": "bun run --filter @kharidyar/web deploy:preview",
		"deploy:production": "bun run --filter @kharidyar/web deploy:production",
		"deployments:production": "bun run --filter @kharidyar/web deployments:production",
		"dev": "bun run --filter @kharidyar/web dev",
		"lint": "eslint . --max-warnings 0",
		"preview": "bun run --filter @kharidyar/web preview",
		"release:smoke": "bun run --filter @kharidyar/web release:smoke",
		"test": "bun run --sequential --filter '@kharidyar/*' --if-present test",
		"typecheck": "tsc -b",
		"versions:production": "bun run --filter @kharidyar/web versions:production"
	},
	"devDependencies": {
		"@eslint/js": "9.39.1",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0"
	},
	"type": "module"
}
