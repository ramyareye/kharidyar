{
	"name": "kharidyar",
	"version": "0.0.0",
	"description": "Private collaborative purchase planning workspace",
	"private": true,
	"packageManager": "bun@1.3.12",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter @kharidyar/web build",
		"cf-typegen": "bun run --filter @kharidyar/web cf-typegen",
		"check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run --filter @kharidyar/web check:deploy",
		"deploy": "bun run --filter @kharidyar/web deploy",
		"dev": "bun run --filter @kharidyar/web dev",
		"lint": "eslint . --max-warnings 0",
		"preview": "bun run --filter @kharidyar/web preview",
		"test": "bun run --filter @kharidyar/web test",
		"typecheck": "tsc -b"
	},
	"devDependencies": {
		"@eslint/js": "9.39.1",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0"
	},
	"type": "module"
}
