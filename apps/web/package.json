{
	"name": "@kharidyar/web",
	"version": "0.0.0",
	"description": "Kharidyar web application and Cloudflare Worker",
	"cloudflare": {
		"label": "Kharidyar",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
		"publish": true
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.2",
		"@cloudflare/playwright": "1.3.0",
		"@kharidyar/contracts": "workspace:*",
		"@kharidyar/domain": "workspace:*",
		"@kharidyar/i18n": "workspace:*",
		"better-auth": "1.7.2",
		"drizzle-orm": "0.45.2",
		"hono": "4.11.1",
		"react": "19.2.1",
		"react-dom": "19.2.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@cloudflare/vitest-plugin": "1.1.2",
		"@types/node": "^26.4.0",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"auth": "1.7.2",
		"drizzle-kit": "0.31.10",
		"typescript": "5.9.3",
		"vite": "^7.0.0",
		"vitest": "4.1.11",
		"wrangler": "^4.127.1"
	},
	"private": true,
	"scripts": {
		"auth:schema": "auth generate --config ./src/auth/schema-config.ts --output ./src/db/schema/auth.ts --adapter drizzle --dialect sqlite --yes",
		"build": "tsc -b && CLOUDFLARE_ENV=production vite build",
		"build:local": "tsc -b && vite build",
		"build:preview": "tsc -b && CLOUDFLARE_ENV=preview vite build",
		"cf-typegen": "wrangler types",
		"check:deploy": "bun run check:deploy:production",
		"check:deploy:preview": "bun run build:preview && wrangler deploy --dry-run",
		"check:deploy:production": "bun run build && wrangler deploy --dry-run",
		"db:check": "drizzle-kit check --config ./drizzle.config.ts",
		"db:generate": "bun run auth:schema && drizzle-kit generate --config ./drizzle.config.ts",
		"db:bookmark:preview": "wrangler d1 time-travel info DB --env preview --json",
		"db:bookmark:production": "wrangler d1 time-travel info DB --env production --json",
		"db:migrate:local": "wrangler d1 migrations apply kharidyar-local --local",
		"db:migrate:preview": "wrangler d1 migrations apply kharidyar-preview --remote --env preview",
		"db:migrate:production": "wrangler d1 migrations apply kharidyar-production --remote --env production",
		"db:migrations:list:local": "wrangler d1 migrations list kharidyar-local --local",
		"db:migrations:list:preview": "wrangler d1 migrations list kharidyar-preview --remote --env preview",
		"db:migrations:list:production": "wrangler d1 migrations list kharidyar-production --remote --env production",
		"db:seed:local": "wrangler d1 execute kharidyar-local --local --file ./seed/development.sql",
		"deploy": "bun run deploy:production",
		"deploy:preview": "bun run build:preview && wrangler deploy",
		"deploy:production": "bun run build && wrangler deploy",
		"deployments:production": "wrangler deployments list --name kharidyar --json",
		"dev": "vite",
		"preview": "bun run build:local && vite preview",
		"release:smoke": "bun run ./scripts/release-smoke.mjs",
		"test": "vitest run && vitest run --config vitest.ui.config.ts",
		"typecheck": "tsc -b",
		"versions:production": "wrangler versions list --name kharidyar --json"
	},
	"type": "module"
}
