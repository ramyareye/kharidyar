/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kharidyar",
	"preview_urls": true,
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": false
		}
	},
	"secrets": {
		"required": [
			"AUTH_TRUSTED_ORIGINS",
			"BETTER_AUTH_SECRET",
			"BETTER_AUTH_URL",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"TAVILY_API_KEY"
		]
	},
	"vars": {
		"RESEARCH_BROWSER_ALLOWED_ORIGIN": "https://kharidyar.formahsa.workers.dev"
	},
	"browser": {
		"binding": "BROWSER"
	},
	"workflows": [
		{
			"name": "kharidyar-research-local",
			"binding": "RESEARCH_WORKFLOW",
			"class_name": "ResearchWorkflow"
		}
	],
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kharidyar-local",
			"migrations_dir": "migrations"
		}
	],
	"env": {
		"preview": {
			"name": "kharidyar-preview",
			"observability": {
				"enabled": true,
				"logs": {
					"enabled": true,
					"head_sampling_rate": 1,
					"invocation_logs": false
				}
			},
			"secrets": {
				"required": [
					"AUTH_TRUSTED_ORIGINS",
					"BETTER_AUTH_SECRET",
					"BETTER_AUTH_URL",
					"GOOGLE_CLIENT_ID",
					"GOOGLE_CLIENT_SECRET",
					"TAVILY_API_KEY"
				]
			},
			"vars": {
				"RESEARCH_BROWSER_ALLOWED_ORIGIN": "https://kharidyar-preview.formahsa.workers.dev"
			},
			"browser": {
				"binding": "BROWSER"
			},
			"workflows": [
				{
					"name": "kharidyar-research-preview",
					"binding": "RESEARCH_WORKFLOW",
					"class_name": "ResearchWorkflow"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "kharidyar-preview",
					"database_id": "153fad62-2d09-41a3-8ee7-f7efd2b91c80",
					"migrations_dir": "migrations"
				}
			]
		},
		"production": {
			"name": "kharidyar",
			"observability": {
				"enabled": true,
				"logs": {
					"enabled": true,
					"head_sampling_rate": 1,
					"invocation_logs": false
				}
			},
			"secrets": {
				"required": [
					"AUTH_TRUSTED_ORIGINS",
					"BETTER_AUTH_SECRET",
					"BETTER_AUTH_URL",
					"GOOGLE_CLIENT_ID",
					"GOOGLE_CLIENT_SECRET",
					"TAVILY_API_KEY"
				]
			},
			"vars": {
				"RESEARCH_BROWSER_ALLOWED_ORIGIN": "https://kharidyar.formahsa.workers.dev"
			},
			"browser": {
				"binding": "BROWSER"
			},
			"workflows": [
				{
					"name": "kharidyar-research",
					"binding": "RESEARCH_WORKFLOW",
					"class_name": "ResearchWorkflow"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "kharidyar-production",
					"database_id": "85ccca6c-adde-4125-87de-a4de614b1091",
					"migrations_dir": "migrations"
				}
			]
		}
	},
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
